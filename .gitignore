# Secrets: never commit real keys or passwords
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Installed packages: reinstall with npm install / pip install -r requirements.txt
node_modules/
backend/venv/
venv/
.venv/

# Python build files
__pycache__/
*.pyc

# Local databases (each developer seeds their own)
*.db
*.sqlite3

# Build output and logs
dist/
logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
.vscode/*
